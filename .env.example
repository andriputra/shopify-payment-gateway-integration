PORT=3000
HOST=http://localhost:3000
STORAGE_DRIVER=json
DATA_DIR=./data

# Gunakan salah satu:
# 1) MYSQL_URL=mysql://user:password@host:3306/database
# 2) atau isi variabel MYSQL_* di bawah
# MYSQL_URL=mysql://root:secret@127.0.0.1:3306/shopify_gateway
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_DATABASE=shopify_gateway
MYSQL_CONNECTION_LIMIT=10
MYSQL_CONNECT_TIMEOUT_MS=5000

SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
APP_SHARED_SECRET=replace_with_random_secret
SHOPIFY_SCOPES=read_orders,write_payment_sessions
SHOPIFY_REDIRECT_PATH=/auth/callback
SHOPIFY_APP_UI_PATH=/app

# Versi Payments Apps API (paymentSessionResolve), lihat https://shopify.dev/docs/api/payments-apps
SHOPIFY_PAYMENTS_API_VERSION=2025-01

# Swipe: jika outbound dapat 403 HTML dari edge, coba samakan UA dengan Postman:
# SWIPE_OUTBOUND_USER_AGENT=PostmanRuntime/7.36.0

# Vercel: kosongkan HOST agar pakai VERCEL_URL otomatis, atau isi https://project-kamu.vercel.app
# Vercel: simpan JSON di /tmp (writable); tanpa ini write ke ./data bisa gagal
# DATA_DIR=/tmp/data
